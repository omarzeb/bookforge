# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
APP_SECRET_KEY=change-me-in-prod
DEBUG=true

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Local dev: use the postgres service from docker-compose
DATABASE_URL=postgresql+asyncpg://bookforge:bookforge@localhost:5432/bookforge
# Production: paste your Neon connection string here (read from Secrets Manager in prod)
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.us-east-1.aws.neon.tech/bookforge?sslmode=require

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Local dev: use the redis service from docker-compose
REDIS_URL=redis://localhost:6379/0
# Production: paste your Upstash Redis URL (read from Secrets Manager in prod)
# REDIS_URL=rediss://default:TOKEN@global-XXX.upstash.io:6379

# ── Encryption ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In production, this lives in AWS Secrets Manager — never commit a real key.
FERNET_KEY=GENERATE_A_REAL_KEY_DO_NOT_COMMIT

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=GENERATE_A_REAL_SECRET_DO_NOT_COMMIT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080    # 7 days

# ── AWS (only needed for S3 uploads and Fargate task launching) ───────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=bookforge-books-YOUR_ACCOUNT_ID
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are injected by App Runner / Fargate
# via IAM roles — do not put real credentials here.

# ── OpenRouter (demo key only — real users supply their own) ──────────────────
OPENROUTER_DEMO_KEY=sk-or-...
DEMO_MODE=false

# ── Feature flags ─────────────────────────────────────────────────────────────
STORAGE_BACKEND=local         # local | s3
