:80 {
    handle /api/* {
        reverse_proxy api:8080
    }

    handle /docs {
        reverse_proxy api:8080
    }

    handle /health {
        reverse_proxy api:8080
    }

    handle /ready {
        reverse_proxy api:8080
    }

    handle {
        reverse_proxy frontend:3000
    }

    encode gzip

    # Security headers
    header {
        # Prevent MIME sniffing
        X-Content-Type-Options "nosniff"

        # Referrer policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Remove server fingerprint
        -Server

        # Permissions policy — block unused browser features
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

        # Content Security Policy
        # frame-ancestors replaces X-Frame-Options
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none';"

        # Defer to CSP for framing (kept for older browsers)
        X-Frame-Options "DENY"
    }

    log {
        output file /data/caddy/access.log {
            roll_size 10MB
            roll_keep 3
        }
        # Redact auth tokens from logs
        format filter {
            wrap json
            fields {
                request>headers>Authorization replace REDACTED
                request>headers>Cookie replace REDACTED
            }
        }
    }
}

# RQ dashboard — only accessible via SSH tunnel or local network
# Access: ssh -L 9181:localhost:9181 yourserver
# Then open http://localhost:9181
# NOT exposed via the main :80 block intentionally
