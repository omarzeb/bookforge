# deploy/local/bookforge.service
# systemd unit — copy to /etc/systemd/system/bookforge.service
# then: sudo systemctl enable bookforge && sudo systemctl start bookforge

[Unit]
Description=BookForge Docker Compose Stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/bookforge/deploy/local
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
ExecReload=/usr/bin/docker compose pull && /usr/bin/docker compose up -d --remove-orphans
TimeoutStartSec=300
TimeoutStopSec=60

# Restart if it fails to start
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
